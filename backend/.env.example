APP_NAME="OFPPT Absences"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-railway-backend.up.railway.app
FRONTEND_URL=https://your-vercel-frontend.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-vercel-frontend.vercel.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting / Reverb disabled (not used by this application)
BROADCAST_CONNECTION=null

FILESYSTEM_DISK=local
AVATAR_DISK=public
IMPORT_DISK=local

# database = web + worker on the same Railway service (see scripts/railway-start.sh)
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1300

CACHE_STORE=database

MAIL_MAILER=brevo
MAIL_FROM_ADDRESS="noreply@your-domain.tld"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo HTTP API (SMTP ports are blocked on Railway)
BREVO_API_KEY=your-brevo-api-key
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email

# Secret for POST /api/system/mail/test (header: X-Mail-Test-Token)
MAIL_TEST_TOKEN=change-me-to-a-long-random-token

# Required only when running: php artisan db:seed --force (production)
ADMIN_EMAIL=admin@your-domain.tld
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NOM=Admin
ADMIN_PRENOM=OFPPT
ADMIN_TELEPHONE=

# Optional: S3-compatible storage for durable avatars (otherwise mount a Railway volume on storage/)
# AVATAR_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
